{
  "experiment_name": "Corrective Experiment C: Action-Conditioned Diffusion",
  "diffusion_schedule": {
    "type": "cosine",
    "timesteps": 1000,
    "s": 0.008,
    "beta_min": 0.0001,
    "beta_max": 0.9999
  },
  "architecture": {
    "model_name": "ActionConditionedUNet",
    "in_channels": 8,
    "out_channels": 4,
    "time_dim": 128,
    "num_actions": 2,
    "action_embedding_dim": 128,
    "action_parameters": 256,
    "total_parameters": 1986020
  },
  "training": {
    "optimizer": "AdamW",
    "learning_rate": 0.0005,
    "weight_decay": 0.0001,
    "batch_size": 8,
    "total_optimizer_steps": 1000,
    "loss_weighting": "unweighted_mse",
    "random_seed": 42
  },
  "dataset_split": {
    "total_characters": 20,
    "actions_per_character": 2,
    "action_mapping": {
      "0": "Neutral Idle F0",
      "1": "South Walk Apex Stride F3"
    },
    "train_characters": ["C_00", "C_01", "C_02", "C_03", "C_04", "C_05", "C_06", "C_07", "C_08", "C_09", "C_10", "C_11", "C_12", "C_13", "C_14", "C_15"],
    "val_characters": ["C_16", "C_17", "C_18", "C_19"],
    "train_samples_count": 32,
    "val_samples_count": 8
  },
  "experiments": {
    "C1_epsilon": {
      "target": "epsilon",
      "description": "Standard DDPM noise-prediction objective"
    },
    "C2_velocity": {
      "target": "v = sqrt(alpha_bar) * epsilon - sqrt(1 - alpha_bar) * x_0",
      "description": "Salimans & Ho progressive/velocity prediction objective"
    }
  }
}

